{
  "name": "emerald-curtain-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5187",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "research": "node scripts/extract-mapping.mjs",
    "check": "npm run test && npm run build",
    "package:source": "node scripts/package-source.mjs",
    "catalogue:build": "tsx scripts/build-starter-catalogue.ts",
    "catalogue:check": "tsx scripts/build-starter-catalogue.ts --check",
    "catalogue:benchmark": "tsx scripts/benchmark-starter-catalogue.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "description": "Emerald Curtain Investigator: guided Pokémon data recovery, SID inference and curtain experiments",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
